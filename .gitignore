# ==============================================================================
# SYNAPSE AI - SECURE GITIGNORE
# Prevents accidental commits of secrets, keys, environment files, and build artifacts
# ==============================================================================

# Secrets & Environment Variables
.env
.env*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
credentials.json
secrets.json
auth.json

# Dependencies & Package Caches
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.npm
/.cache
/.local
/.config

# Next.js & Build Outputs
/.next/
/out/
/build
/dist
/.turbo
/.next-profiles/

# Testing & Telemetry
/coverage
*.lcov
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Operating System & IDE Artifacts
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*.tsbuildinfo
next-env.d.ts
